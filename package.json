{
  "name": "glow-ui",
  "version": "0.1.0",
  "description": "Glow Design System — code registry (shadcn) + Storybook",
  "scripts": {
    "storybook": "storybook dev -p 6006",
    "build:storybook": "storybook build -o dist",
    "build:registry": "shadcn build -o dist/r",
    "build": "npm run check && npm run build:storybook && npm run build:registry",
    "check": "npm run typecheck && npm run lint:tokens",
    "typecheck": "tsc --noEmit",
    "lint:tokens": "node scripts/check-arbitrary-values.mjs registry"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mr-yemets/glow-ui.git"
  },
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/mr-yemets/glow-ui/issues"
  },
  "homepage": "https://github.com/mr-yemets/glow-ui#readme",
  "dependencies": {
    "@radix-ui/react-slot": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.2",
    "@storybook/addon-designs": "^11.1.4",
    "@storybook/addon-docs": "^10.6.2",
    "@storybook/react-vite": "^10.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "shadcn": "^4.21.5",
    "storybook": "^10.6.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "private": true,
  "type": "module"
}
